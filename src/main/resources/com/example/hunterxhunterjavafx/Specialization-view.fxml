<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="661.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hunterxhunterjavafx.TransmutatorController">
    <children>
        <ImageView fitHeight="267.0" fitWidth="270.0" layoutX="282.0" layoutY="41.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@Images/alluka.jpg" />
            </image>
        </ImageView>
        <Text layoutX="90.0" layoutY="75.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Gon Freccs">
            <font>
                <Font name="DejaVu Sans Condensed Bold" size="20.0" />
            </font>
        </Text>
        <Text layoutX="34.0" layoutY="404.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Alluka can grant nearly any wish, from healing fatal injuries to performing impossible feats, but these wishes come with strict rules and dangerous consequences if previous requests are not properly fulfilled. Alluka herself has no control over Nanika’s powers, yet she remains sweet, affectionate, and deeply loyal to Killua, who is the only one able to interact with her without fear. Together, Alluka and Nanika form a rare fusion of innocence and overwhelming supernatural power." textAlignment="JUSTIFY" wrappingWidth="533.0">
            <font>
                <Font name="DejaVu Serif" size="15.0" />
            </font>
        </Text>
        <Text layoutX="29.0" layoutY="112.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Alluka Zoldyck is one of the most mysterious and emotionally complex characters in Hunter x Hunter, known for her gentle personality and her extraordinary, reality-bending abilities." textAlignment="JUSTIFY" wrappingWidth="233.0">
            <font>
                <Font name="DejaVu Serif" size="15.0" />
            </font>
        </Text>
        <Text layoutX="230.0" layoutY="364.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nen Abilities" textAlignment="CENTER">
            <font>
                <Font name="DejaVu Sans Condensed Bold" size="16.0" />
            </font>
        </Text>
      <Button fx:id="home" layoutX="271.0" layoutY="621.0" mnemonicParsing="false" text="Home" onAction="#goToHome"/>
    </children>
</AnchorPane>
