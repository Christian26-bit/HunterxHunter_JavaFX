<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="661.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hunterxhunterjavafx.EnhancerController">
   <children>
      <ImageView fitHeight="267.0" fitWidth="270.0" layoutX="282.0" layoutY="41.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/gon.jpg" />
         </image>
      </ImageView>
      <Text layoutX="90.0" layoutY="75.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Gon Freccs">
         <font>
            <Font name="DejaVu Sans Condensed Bold" size="20.0" />
         </font>
      </Text>
      <Text layoutX="34.0" layoutY="404.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Gon Freecss is an incredibly talented Enhancer—one of the six types of Nen users—meaning his aura is best suited for reinforcing and strengthening his physical body and raw attack power. His signature and only developed Nen ability is Jajanken (Rock-Paper-Scissors), a versatile Hatsu technique that utilizes three different Nen categories for varying ranges: Rock (Guu) is his ultimate close-range attack, using maximum Enhancement to deliver an incredibly powerful, aura-charged punch; Scissors (Choki) is a mid-range attack utilizing Transmutation to shape his aura into a sharp blade extending from his fingers; and Paper (Paa) is a long-range blast using Emission to fire a ball of pure aura." textAlignment="JUSTIFY" wrappingWidth="533.0">
         <font>
            <Font name="DejaVu Serif" size="15.0" />
         </font>
      </Text>
      <Text layoutX="29.0" layoutY="112.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Gon Freecss is the main protagonist of Hunter x Hunter—a character defined by his unwavering optimism, boundless energy, and deep connection to the natural world." textAlignment="JUSTIFY" wrappingWidth="233.0">
         <font>
            <Font name="DejaVu Serif" size="15.0" />
         </font>
      </Text>
      <Text layoutX="230.0" layoutY="364.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nen Abilities" textAlignment="CENTER">
         <font>
            <Font name="DejaVu Sans Condensed Bold" size="16.0" />
         </font>
      </Text>
      <Button fx:id="home" layoutX="270.0" layoutY="621.0" mnemonicParsing="false" text="Home" onAction="#goToHome"/>
   </children>
</AnchorPane>
